PORT=4000
DATABASE_URL=postgresql://olw:olw@localhost:5432/our_little_world
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173
# Optional — presence is kept in memory without it
REDIS_URL=

# ---- Production ----
# NODE_ENV=production
# Secure cookies need HTTPS. Set false only to try production over plain http.
# COOKIE_SECURE=true
# Folder with the built web app (client/dist). Defaults to server/public if it exists.
# STATIC_DIR=
# Where uploaded photos live — put this on a persistent volume.
# UPLOAD_DIR=
# What's open (comma-separated, or "all"). Keep in sync with the web app's VITE_FEATURES.
ENABLED_FEATURES=chat,movie
# "friends" hides anything romantic; "couple" shows everything.
RELATIONSHIP=friends
# WebRTC. STUN is enough for most networks; add TURN for strict ones.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
