# Copy to .env.prod and fill in. Never commit the real file.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
POSTGRES_PASSWORD=
# Keep true behind HTTPS. Only set false to try it over plain http.
COOKIE_SECURE=true
# What's open. Must match the web app build (VITE_FEATURES / VITE_RELATIONSHIP build args).
ENABLED_FEATURES=chat,movie
RELATIONSHIP=friends
# Optional: a TURN server for strict networks (video bubbles / calls).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
PORT=4000
