# Demo mode: runs entirely in the browser with a simulated partner.
# No PostgreSQL, Redis, TURN server or API keys needed.
VITE_DEMO_MODE=true

# Used when VITE_DEMO_MODE=false
VITE_API_URL=
VITE_SOCKET_URL=
# Comma-separated ICE servers for WebRTC (STUN/TURN)
VITE_ICE_SERVERS=stun:stun.l.google.com:19302
